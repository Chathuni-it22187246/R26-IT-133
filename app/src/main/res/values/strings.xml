    <string name="help_title">Help</string>
    <string name="help_overview_title">Application overview</string>
    <string name="help_overview_body">GreenHands is an AR–IoT Smart Greenhouse Platform. Heat Distribution is one of four components, alongside Sensor Placement, Harvesting and Decision Making.</string>
    <string name="help_dash_title">Using the dashboard</string>
    <string name="help_dash_body">The dashboard shows Preview Mode sample values and the four platform components. Heat Distribution opens crop configuration. Other components open Coming Soon pages.</string>
    <string name="help_heat_title">Heat Distribution</string>
    <string name="help_heat_body">After you open Heat Distribution, use Crops to configure crop, growth stage and Day/Night climate targets. Automatic calculation derives equipment thresholds. Save &amp; Continue stores both periods before moving on. Research sources stay under the Sources tab.</string>
    <string name="help_demo_title">Preview Mode</string>
    <string name="help_demo_body">Preview Mode uses labelled sample values. It does not read hardware or control equipment.</string>
    <string name="help_safety_title">Safety note</string>
    <string name="help_safety_body">This build does not control fans, foggers or any physical equipment. Treat every reading as a sample until a live greenhouse is connected.</string>
    <string name="about_title">About</string>
    <string name="about_heading">GreenHands</string>
    <string name="about_subtitle">AR–IoT Smart Greenhouse Platform</string>
    <string name="about_body">GreenHands is an AR–IoT Smart Greenhouse Platform designed to help growers monitor greenhouse conditions, optimize sensor placement, visualize heat distribution, assess crop health, predict harvesting time, and receive recommended actions. It brings greenhouse information, augmented-reality visualization, crop analysis and decision support into one mobile workspace.</string>
    <string name="about_version">Version 2.1.3-demo</string>
    <string name="about_prototype_status">Research prototype. Live AR, IoT hardware and greenhouse validation are not claimed in this build.</string>
    <string name="about_research_title">Research and academic context</string>
    <string name="about_research_body">Heat Distribution suggested values are drawn from published crop-climate sources. Full references, classifications and limitations are listed under Heat Distribution → Sources.</string>
    <string name="about_privacy_link">Privacy</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_demo_title">On-device data</string>
    <string name="privacy_demo_body">Names, emails, optional profile photos and configuration figures stay in this session and on-device storage. The app never requests a Google account.</string>
    <string name="privacy_sensor_title">Sensor data comes later</string>
    <string name="privacy_sensor_body">Live greenhouse readings are not connected. Dashboard values are Preview Mode sample values and are not live sensor readings.</string>
    <string name="privacy_camera_title">Camera permission is deferred</string>
    <string name="privacy_camera_body">Camera permission will only be requested when AR is added. Profile photos use the system Photo Picker and do not require broad storage access.</string>
    <string name="privacy_upload_title">No cloud upload</string>
    <string name="privacy_upload_body">This build does not upload personal or sensor data to Firebase, a backend or any other service.</string>
    <string name="logout_title">Log out</string>
    <string name="logout_heading">Leave the workspace?</string>
    <string name="logout_body">You will return to Sign In. Authenticated screens will be removed from the back stack.</string>
    <string name="logout_action">Logout</string>
    <string name="notifications_title">Notifications</string>
    <string name="notifications_paused">Notifications are paused in Settings. Preview alerts below are still listed so this action is never a dead button.</string>
    <string name="notifications_temp">No live temperature sensor</string>
    <string name="notifications_temp_body">Temperature will appear on the dashboard when a greenhouse sensor is connected. Until then the overview shows --.</string>
    <string name="notifications_rh">No live humidity sensor</string>
    <string name="notifications_rh_body">Humidity will appear on the dashboard when a greenhouse sensor is connected. Until then the overview shows --.</string>
    <string name="notifications_heat">Preview: Heat Distribution is available</string>
    <string name="notifications_heat_body">Open it from the dashboard to continue Heat Distribution configuration.</string>

