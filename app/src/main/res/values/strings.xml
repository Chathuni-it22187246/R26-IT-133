    <string name="coming_soon_sensor_title">Sensor Placement</string>
    <string name="coming_soon_sensor_body">Sensor Placement is designed to find optimal sensor positions and identify coverage gaps for reliable greenhouse monitoring. This component is coming soon and is not available in this build.</string>
    <string name="coming_soon_harvest_title">Harvesting</string>
    <string name="coming_soon_harvest_body">Harvesting is designed to assess crop health and predict the expected harvesting date. This component is coming soon and is not available in this build.</string>
    <string name="coming_soon_decision_title">Decision Making</string>
    <string name="coming_soon_decision_body">Decision Making is designed to provide recommended decisions and practical actions based on greenhouse and crop conditions. This component is coming soon and is not available in this build.</string>
